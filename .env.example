# ──────────────────────────────────────────────────────────────
# CorpLawUpdates.in — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@corplawupdates.in

# ── Admin Panel ───────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SECRET_SALT=
ADMIN_EMAIL=

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.corplawupdates.in

# ── Google Gemini API Keys (Free Tier rotation fallback) ──────
# Add up to 4 keys for automatic rotation on quota exhaustion.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY_2=
GOOGLE_GEMINI_API_KEY_3=
GOOGLE_GEMINI_API_KEY_4=

# ── Upstash Redis / Vercel KV (Rate Limiting & Caching) ───────
# Get from: https://console.upstash.com/ or Vercel Storage tab
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative env var names (some integrations use these):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push Notifications (VAPID Keys) ───────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@corplawupdates.in

# ── Company Data API (MCA / data.gov.in) ──────────────────────
# Register at: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_COMPANY_MASTER_RESOURCE_ID=

# ── Cron Job Security ─────────────────────────────────────────
# Used to authenticate Vercel cron job requests.
# Generate a strong random string: openssl rand -hex 32
CRON_SECRET=

# ── SEO / Verification ────────────────────────────────────────
# Google Search Console HTML tag verification value
NEXT_PUBLIC_GSC_VERIFICATION=
# IndexNow API key (for instant URL indexing)
INDEXNOW_API_KEY=

# ── Analytics (optional) ──────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
